#version 460 core
// The terrain's culling on the GPU, from every location of the held pools as the GPU keeps them (OcclusionCulling.Rows), not
// from what the CPU's frustum culling left: per location ModelDataPoolLocation.IsVisible, bit for bit - !Hide, the chunk's
// CullVisible bit of this frame's buffer, then by misc.y the mode's test: CullNormal FrustumCulling.InFrustumAndRange's five
// planes (Plane.AABBisOutside in doubles, nothing contracted or reordered) and its LOD range; the shadow passes
// InFrustumShadowPass's range in floats and six planes, the far pass LOD 1 and up only - then, for the camera, cull.comp's
// occlusion test of the box, and a draw command in its pool draw's region for each location left, counted per draw. One work group row (y) per pool draw of the call, the
// locations of its pool along x. Verdicts keep pass 0's occlusion verdict per location for pass 1; a location the frustum or its
// flags left out gets none, so pass 1 never draws it. flags.y picks the pass as in cull.comp:
//   0  test, keep each verdict (against the previous frame's pyramid moved by the camera's step, or this frame's)
//   1  test again only what pass 0 hid, against this frame's pyramid
//   2  keep everything the frustum leaves (no pyramid yet)
//   3  as 1, but keep what pass 0 hid
// Written for OpenGL and Vulkan alike: explicit bindings no two resources share, no loose uniforms. Needs doubles.
layout(local_size_x = 64) in;

const int Slabs = 4;                // per direction (FaceSorting.Slabs; 6 * Slabs bits fit a verdict below Whole)
const int Segments = 6 * Slabs + 1; // the slabs, then the rest
const uint Whole = 0x80000000u;     // a row's verdict: pass 0 hid it whole; else bit s, pass 0 hid slab s

struct Row
{
    vec3 centre; // FrustumCullSphere.x, y, z
    uint count;  // indices
    vec3 extent; // radius, radiusY, radiusZ, each divided by 1.7320508 in float as AABBisOutside does
    uint first;  // first index
    uint flags;  // bit 0: Hide; bits 1-3: LodLevel 0 to 3, 4 for a level above, 5 for one below 0; bit 4: sorted
    uint chunk;  // the location's chunk in Chunks
    uvec2 unused;
    uint slabs[3 * Slabs];  // sorted (FaceSorting): faces per slab, two to a uint (slab s in the low half of s / 2 when even); slab
                     // d * Slabs + j is direction d's (-X, +X, -Y, +Y, -Z, +Z) j-th, by plane least first; the rest after them
    uint planes[3 * Slabs]; // each slab's least plane (low byte) and greatest (high byte) relative to centre in quarter blocks, signed,
                     // rounded away from its faces; two slabs to a uint like slabs
};

struct Command // DrawElementsIndirectCommand, VkDrawIndexedIndirectCommand
{
    uint count;
    uint instances;
    uint first;
    int baseVertex;
    uint baseInstance;
};

layout(std140, binding = 14) uniform Params
{
    mat4 viewProjection; // of the frame the pyramid belongs to, camera-relative
    vec4 shift;          // xyz: this frame's camera minus that frame's
    ivec4 sizes;         // pyramid level 0 width, height, levels; w unused
    ivec4 flags;         // x: 1 = the pyramid is this frame's; y: the pass; z: the first per-draw count; w: the region base
    ivec4 span;          // y: the call's first pool draw; z: its pool draws
};

layout(std140, binding = 15) uniform Frustum
{
    dvec4 planes[6];     // the culler's frustum: normal xyz, D
    dvec4 camera;        // xyz: the camera the boxes are relative to
    dvec4 player;        // x, y: the culler's playerPos X and Z; z: the far cache's radius squared, w: 1 when it is on
    dvec4 lods;          // x: (double)(lod0BiasSq + 1024f), y: (double)ViewDistanceSq, z: lod2BiasSq, w: 1 when lod0BiasSq > 0
    dvec4 shadow;        // x, y: shadowRangeX, shadowRangeZ
    ivec4 misc;          // x: ModelDataPoolLocation.VisibleBufIndex; y: 0 CullNormal, 1 the near shadow pass, 2 the far one,
                         // 3 the far cache's pass (CullNormal's rows past its radius, no verdicts, no counts);
                         // z: 1 when back faces are culled (a sorted row's directions facing away are left out), 2 so and
                         // each direction's part past its split too (what Komet sends); w: 1 when the
                         // shadow passes leave out what casts nothing into the view (Casts)
    dvec4 casters[5];    // the camera's near, left, right, top and bottom planes this frame, each moved out by a margin;
                         // CullNormal with the far cache: the planes of the view it holds, each moved in
    dvec4 eye;           // xyz: where the view matrix puts the eye; camera is the player's position (CameraPos, the feet)
};

const double Beyond = 1.0 / 32.0; // the eye this far behind a slab's nearest plane sees none of its faces
const uint Runs = 4u;              // commands a row may take (OcclusionCulling.Runs)

layout(binding = 31) uniform sampler2D pyramid;

// counters[0..3] per frame: locations the frustum left, of them hidden, their triangles, of them hidden, in pass 0; [4..7] the
// same in pass 1; then from flags.z one command count per draw
layout(std430, binding = 5) buffer Counters
{
    uint counters[];
};

layout(std430, binding = 6) buffer Verdicts
{
    uint verdicts[]; // per row
};

layout(std430, binding = 7) writeonly buffer Commands
{
    Command commands[];
};

layout(std430, binding = 8) readonly buffer Starts
{
    uint starts[]; // per pool draw, its region of commands
};

layout(std430, binding = 9) readonly buffer Rows
{
    Row rows[];
};

layout(std430, binding = 10) readonly buffer Chunks
{
    uint chunks[]; // per chunk, its CullVisible bits
};

layout(std430, binding = 11) readonly buffer Pools
{
    uvec2 pools[]; // per pool draw: its pool's first row and row count
};

const uint Buckets = 64u; // sort.comp's

layout(std430, binding = 12) writeonly buffer Keys
{
    uint keys[]; // per command of the camera's first pass (region base 0), beside it: its row's bucket, nearest first
};

// Plane.AABBisOutside: the corner the normal points to, the sphere's floats widened, then the plane equation in doubles
bool Outside(dvec4 plane, Row row)
{
    precise double x = double(row.centre.x) + double(plane.x > 0.0 ? row.extent.x : -row.extent.x);
    precise double y = double(row.centre.y) + double(plane.y > 0.0 ? row.extent.y : -row.extent.y);
    precise double z = double(row.centre.z) + double(plane.z > 0.0 ? row.extent.z : -row.extent.z);
    precise double xy = x * plane.x + y * plane.y;
    precise double xyz = xy + z * plane.z;
    precise double d = xyz + plane.w;
    return d < 0.0;
}

// A non-negative double rounded to the nearest float (ties to even), as a double: in its bits, since compilers drop a
// double(float(x)) round trip as a no-op - SPIR-V's NoContraction does not reach conversions
double FloatRounded(double value)
{
    uvec2 bits = unpackDouble2x32(value); // x: the low word, y: the high word
    uint dropped = bits.x & 0x1FFFFFFFu;  // the 29 mantissa bits a float has not
    bool up = dropped > 0x10000000u || (dropped == 0x10000000u && (bits.x & 0x20000000u) != 0u);
    uint low = bits.x & ~0x1FFFFFFFu;
    if (up)
    {
        uint raised = low + 0x20000000u;
        bits.y += raised < low ? 1u : 0u;
        low = raised;
    }

    return packDouble2x32(uvec2(low, bits.y));
}

// FrustumCulling.InFrustumAndRange after the planes: BlockPos.HorDistanceSqTo (in doubles, returned as a float), then the
// location's LOD level's range
bool InRange(Row row, uint lod)
{
    precise double dx = double(row.centre.x) - player.x;
    precise double dz = double(row.centre.z) - player.y;
    precise double squared = dx * dx + dz * dz;
    double distance = FloatRounded(squared);
    if (lod == 0u) return lods.w > 0.0 && distance < lods.x;
    if (lod == 1u) return distance < lods.y;
    if (lod == 2u) return distance <= lods.z;
    if (lod == 3u) return distance > lods.z && distance < lods.y;
    return false;
}

// A shadow pass's caster that casts into nothing the camera sees: outside one of its planes (moved out by the margin) which the
// light does not cross inward, its box swept along the light only moves farther out. A shadow pass's first plane is its near
// plane, facing along the light.
bool Casts(Row row)
{
    if (misc.w == 0) return true;
    dvec3 light = planes[0].xyz;
    for (int p = 0; p < 5; p++)
        if (dot(casters[p].xyz, light) <= 0.0 && Outside(casters[p], row)) return false;
    return true;
}

// The row's box wholly inside the far cache's view: its corner nearest to each plane's inside on it
bool Inside(Row row)
{
    for (int p = 0; p < 5; p++)
    {
        dvec4 plane = casters[p];
        precise double x = double(row.centre.x) + double(plane.x > 0.0 ? -row.extent.x : row.extent.x);
        precise double y = double(row.centre.y) + double(plane.y > 0.0 ? -row.extent.y : row.extent.y);
        precise double z = double(row.centre.z) + double(plane.z > 0.0 ? -row.extent.z : row.extent.z);
        if (x * plane.x + y * plane.y + z * plane.z + plane.w < 0.0) return false;
    }

    return true;
}

// The far cache's split (player.w on): its own pass takes the rows past its radius; the camera's leaves it those its view holds
bool Split(Row row)
{
    if (player.w == 0.0) return misc.y == 0;
    precise double dx = double(row.centre.x) - player.x;
    precise double dz = double(row.centre.z) - player.y;
    bool far = dx * dx + dz * dz >= player.z;
    return misc.y == 3 ? far : !far || !Inside(row);
}

// ModelDataPoolLocation.IsVisible(mode, culler)
bool Visible(Row row)
{
    if ((row.flags & 1u) != 0u || ((chunks[row.chunk] >> uint(misc.x)) & 1u) == 0u) return false;
    uint lod = (row.flags >> 1) & 7u;
    if (misc.y == 0 || misc.y == 3)
    {
        for (int p = 0; p < 5; p++)
            if (Outside(planes[p], row)) return false;
        return InRange(row, lod) && Split(row);
    }

    // InFrustumShadowPass: (float)playerPos.X - sphere.x in floats, widened for the comparison, then all six planes
    precise float dx = abs(float(player.x) - row.centre.x);
    precise float dz = abs(float(player.y) - row.centre.z);
    if (double(dx) >= shadow.x || double(dz) >= shadow.y) return false;
    for (int p = 0; p < 6; p++)
        if (Outside(planes[p], row)) return false;
    return (misc.y == 1 || (lod >= 1u && lod <= 4u)) && Casts(row); // the far pass: LodLevel >= 1
}

// The row's bucket: by the square root of its box's distance from the camera, fine near and coarse far
uint Bucket(Row row)
{
    vec3 centre = vec3(dvec3(row.centre) - camera.xyz);
    float distance = length(max(abs(centre) - row.extent, vec3(0.0)));
    return min(uint(sqrt(distance) * 2.8), Buckets - 1u);
}

// cull.comp's occlusion test of a box (relative to this frame's camera) as Occlusion.Box makes it: the location's, or a slab's
bool Hidden(vec3 low, vec3 high)
{
    low += shift.xyz;
    high += shift.xyz;
    vec2 lo = vec2(1.0), hi = vec2(-1.0);
    float nearest = 1.0;
    for (int corner = 0; corner < 8; corner++)
    {
        vec3 p = vec3((corner & 1) != 0 ? high.x : low.x, (corner & 2) != 0 ? high.y : low.y,
                      (corner & 4) != 0 ? high.z : low.z);
        vec4 clip = viewProjection * vec4(p, 1.0);
        if (clip.w <= 1e-4) return false;
        vec3 ndc = clip.xyz / clip.w;
        lo = min(lo, ndc.xy);
        hi = max(hi, ndc.xy);
        nearest = min(nearest, ndc.z * 0.5 + 0.5);
    }

    if (flags.x == 0 && (any(lessThan(lo, vec2(-1.0))) || any(greaterThan(hi, vec2(1.0))))) return false;
    vec2 size = vec2(sizes.xy);
    vec2 from = clamp(lo * 0.5 + 0.5, 0.0, 1.0) * size - 1.0, to = clamp(hi * 0.5 + 0.5, 0.0, 1.0) * size + 1.0;
    for (int at = 0; at < sizes.z; at++)
    {
        ivec2 edge = textureSize(pyramid, at) - 1; // the last texel holds what lies past it
        ivec2 first = clamp(ivec2(floor(from / float(1 << at))), ivec2(0), edge);
        ivec2 last = clamp(ivec2(floor(to / float(1 << at))), first, edge);
        if (any(greaterThan(last - first, ivec2(1)))) continue;
        float farthest = max(max(texelFetch(pyramid, first, at).r, texelFetch(pyramid, ivec2(last.x, first.y), at).r),
                             max(texelFetch(pyramid, ivec2(first.x, last.y), at).r, texelFetch(pyramid, last, at).r));
        return nearest > farthest;
    }

    return false;
}

// A slab's box: the location's (centre relative to the camera), cut on its axis to its planes (which never reach past the box's
// faces by more than rounding)
bool Hidden(vec3 centre, vec3 extent, int axis, float least, float greatest)
{
    vec3 low = centre - extent, high = centre + extent;
    low[axis] = max(low[axis], centre[axis] + least);
    high[axis] = min(high[axis], centre[axis] + greatest);
    return high[axis] >= low[axis] && Hidden(low, high);
}

void main()
{
    uint draw = uint(span.y) + gl_WorkGroupID.y;
    uvec2 pool = pools[draw];
    if (gl_GlobalInvocationID.x >= pool.y) return;
    uint index = pool.x + gl_GlobalInvocationID.x;
    int pass = flags.y;
    bool again = pass == 1 || pass == 3;
    uint verdict = again ? verdicts[index] : 0u;
    if (again && verdict == 0u) return; // drawn in pass 0 already, or left out by the frustum
    Row row = rows[index];
    bool viewed = misc.y == 0; // the shadow passes keep no verdicts and count nothing: the camera's passes read those
    if (!again && !Visible(row))
    {
        if (viewed) verdicts[index] = 0u;
        return;
    }

    bool testing = pass == 0 || pass == 1, whole = !again || (verdict & Whole) != 0u;
    vec3 centre = vec3(dvec3(row.centre) - camera.xyz);
    bool hidden = testing && whole && Hidden(centre - row.extent, centre + row.extent);
    uint stats = again ? 4u : 0u, triangles = row.count / 3u;
    if (viewed && whole)
    {
        atomicAdd(counters[stats], 1u);
        atomicAdd(counters[stats + 2u], triangles);
    }

    if (!again && viewed && (hidden || misc.z == 0 || (row.flags & 16u) == 0u)) verdicts[index] = hidden ? Whole : 0u;
    if (hidden)
    {
        atomicAdd(counters[stats + 1u], 1u);
        atomicAdd(counters[stats + 3u], triangles);
        return;
    }

    // The runs of faces to draw: the whole range, or for a sorted row the slabs facing the camera (each slab of a +a direction is
    // seen from above its least plane, of a -a one from below its greatest) that the depth pyramid does not hide, with misc.z 2;
    // with 1 a direction is one slab, its least plane to its greatest. Again for the slabs pass 0 hid (verdict bits) only those.
    // Neighbours are joined; past Runs the smallest gaps are drawn over.
    uint firsts[Segments], ends[Segments];
    uint runs = 0u, drawn = 0u;
    if (misc.z == 0 || (row.flags & 16u) == 0u)
    {
        if (whole)
        {
            firsts[0] = row.first;
            ends[0] = row.first + row.count;
            runs = 1u;
        }
    }
    else
    {
        dvec3 seen = eye.xyz - dvec3(row.centre);
        bool slabbed = misc.z == 2, occluding = slabbed && testing && viewed;
        uint hid = 0u, faces = 0u;
        bool open = false;
        for (int s = 0; s < Segments; s++)
        {
            uint n;
            bool shown = whole || s < Segments - 1 && (verdict >> uint(s) & 1u) != 0u;
            if (s < Segments - 1)
            {
                int d = s / Slabs, axis = d / 2;
                if (!slabbed && s % Slabs != 0) continue; // counted with the direction's first
                n = 0u;
                float least = 0.0, greatest = 0.0;
                for (int j = 0; j < (slabbed ? 1 : Slabs); j++) // the direction whole: its first slab's least plane to its last's greatest
                {
                    uint k = (row.slabs[(s + j) / 2] >> (16u * uint((s + j) % 2))) & 0xFFFFu;
                    if (k == 0u) continue;
                    uint b = row.planes[(s + j) / 2] >> (16u * uint((s + j) % 2));
                    if (n == 0u) least = float(bitfieldExtract(int(b), 0, 8)) * 0.25;
                    greatest = float(bitfieldExtract(int(b), 8, 8)) * 0.25;
                    n += k;
                }

                if (n == 0u) continue;
                double at = seen[axis];
                shown = shown && (d % 2 == 1 ? at >= double(least) - Beyond : at <= double(greatest) + Beyond);
                if (shown && occluding && Hidden(centre, row.extent, axis, least, greatest))
                {
                    shown = false;
                    hid |= 1u << uint(s);
                }
            }
            else n = row.count / 6u - faces;
            if (shown && n > 0u)
            {
                uint first = row.first + 6u * faces;
                if (!open) firsts[runs++] = first;
                ends[runs - 1u] = first + 6u * n;
                open = true;
            }
            else if (n > 0u) open = false;
            faces += n;
        }

        if (!again && viewed) verdicts[index] = hid;
        while (runs > Runs) // draw over the smallest gap
        {
            uint at = 0u, gap = 0xFFFFFFFFu;
            for (uint r = 0u; r + 1u < runs; r++)
                if (firsts[r + 1u] - ends[r] < gap)
                {
                    gap = firsts[r + 1u] - ends[r];
                    at = r;
                }

            ends[at] = ends[at + 1u];
            for (uint r = at + 1u; r + 1u < runs; r++)
            {
                firsts[r] = firsts[r + 1u];
                ends[r] = ends[r + 1u];
            }

            runs--;
        }
    }

    for (uint r = 0u; r < runs; r++) drawn += ends[r] - firsts[r];
    if (viewed && whole && drawn < row.count) atomicAdd(counters[stats + 3u], (row.count - drawn) / 3u); // facing away or hidden
    if (runs == 0u) return;
    uint slot = atomicAdd(counters[uint(flags.z) + draw], runs), bucket = Bucket(row);
    for (uint r = 0u; r < runs; r++)
    {
        commands[uint(flags.w) + starts[draw] + slot + r] = Command(ends[r] - firsts[r], 1u, firsts[r], 0, 0u);
        if (flags.w == 0) keys[starts[draw] + slot + r] = bucket;
    }
}
